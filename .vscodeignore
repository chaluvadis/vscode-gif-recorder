# Source files (esbuild bundles everything into extension.js)
src/**

# Build config and tools
esbuild.js
**/tsconfig.json
biome.json

# VS Code / test config
.vscode/**
.vscode-test/**
.vscode-test-web/**
vscode-test*/**

# Lock files and workspace config (not needed at runtime)
package-lock.json
pnpm-lock.yaml
pnpm-workspace.yaml
yarn.lock
.yarnrc*
.gitignore
.DS_Store

# Documentation
README.md
readme.md
CHANGELOG.md
CODE_OF_CONDUCT.md
CONTRIBUTING.md
vsc-extension-quickstart.md

# Tests / tools / CI
obj/
testdata/
tools/**
.github/**

# TypeScript source and source maps (esbuild output only)
**/*.ts
**/*.map

# Stale tsc output files (esbuild bundles all into extension.js and worker)
out/*.js
out/test/**
!out/extension.js
!out/worker/gifConverterWorker.js

# Unused large media files (only referenced in README)
media/recording.gif
media/logo.svg
